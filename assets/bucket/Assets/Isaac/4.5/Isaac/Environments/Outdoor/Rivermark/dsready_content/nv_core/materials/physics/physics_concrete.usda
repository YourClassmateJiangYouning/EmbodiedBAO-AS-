#usda 1.0
(
    defaultPrim = "Concrete"
    metersPerUnit = 1
    upAxis = "Z"
)

def Material "Concrete" (
    prepend apiSchemas = ["PhysicsMaterialAPI"]
)
{
    custom string inputs:nonvisual:attributes = "none"
    string inputs:nonvisual:base = "concrete"
    string inputs:nonvisual:coating = "none"
    float physics:density = 2500
    float physics:dynamicFriction = 0.24
    float physics:restitution = 0.01
    float physics:staticFriction = 0.25
}

