#usda 1.0
(
    defaultPrim = "Asphalt"
    metersPerUnit = 1
    upAxis = "Z"
)

def Material "Asphalt" (
    prepend apiSchemas = ["PhysicsMaterialAPI"]
)
{
    custom string inputs:nonvisual:attributes = "none"
    string inputs:nonvisual:base = "asphalt"
    string inputs:nonvisual:coating = "none"
    float physics:density = 2322
    float physics:dynamicFriction = 0.7
    float physics:restitution = 0.1
    float physics:staticFriction = 0.7
}

